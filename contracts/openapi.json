{
  "openapi": "3.1.0",
  "info": {
    "title": "Pensieve API",
    "description": "The Midnight Archive. This milestone uses prepared demo runs.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/corpora": {
      "get": {
        "summary": "Corpora",
        "operationId": "corpora_api_corpora_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Corpus"
                  },
                  "type": "array",
                  "title": "Response Corpora Api Corpora Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo": {
      "get": {
        "summary": "Demo",
        "operationId": "demo_api_demo_get",
        "parameters": [
          {
            "name": "corpus_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "wizarding-notes",
              "title": "Corpus Id"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Mode",
              "default": "compare"
            }
          },
          {
            "name": "question_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Question Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRun"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Create Run",
        "operationId": "create_run_api_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRun"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run_api_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRun"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancel Run",
        "operationId": "cancel_run_api_runs__run_id__cancel_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRun"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/runs/{run_id}/evidence/{citation_id}": {
      "get": {
        "summary": "Evidence",
        "operationId": "evidence_api_runs__run_id__evidence__citation_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "citation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Citation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiProblem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiProblem"
      },
      "Branch": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "method": {
            "$ref": "#/components/schemas/Method"
          },
          "status": {
            "$ref": "#/components/schemas/BranchStatus"
          },
          "answer_title": {
            "type": "string",
            "title": "Answer Title"
          },
          "introduction": {
            "type": "string",
            "title": "Introduction"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "conclusion": {
            "type": "string",
            "title": "Conclusion"
          },
          "insufficient_evidence": {
            "type": "boolean",
            "title": "Insufficient Evidence"
          },
          "context": {
            "$ref": "#/components/schemas/ContextManifest"
          },
          "metrics": {
            "$ref": "#/components/schemas/RunMetrics"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "method",
          "status",
          "answer_title",
          "introduction",
          "claims",
          "conclusion",
          "insufficient_evidence",
          "context",
          "metrics"
        ],
        "title": "Branch"
      },
      "BranchStatus": {
        "type": "string",
        "enum": [
          "queued",
          "preparing_context",
          "generating",
          "validating",
          "complete",
          "cancelled",
          "failed"
        ],
        "title": "BranchStatus"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "start_offset": {
            "type": "integer",
            "title": "Start Offset"
          },
          "end_offset": {
            "type": "integer",
            "title": "End Offset"
          },
          "structural_status": {
            "type": "string",
            "enum": [
              "verified",
              "pending",
              "invalid"
            ],
            "title": "Structural Status"
          },
          "support_status": {
            "type": "string",
            "enum": [
              "fixture_reviewed",
              "not_assessed",
              "supported",
              "unsupported"
            ],
            "title": "Support Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "number",
          "source_id",
          "excerpt",
          "start_offset",
          "end_offset",
          "structural_status",
          "support_status"
        ],
        "title": "Citation"
      },
      "Claim": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "citations"
        ],
        "title": "Claim"
      },
      "ContextManifest": {
        "properties": {
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Ids"
          },
          "selected_source_count": {
            "type": "integer",
            "title": "Selected Source Count"
          },
          "supplied_source_count": {
            "type": "integer",
            "title": "Supplied Source Count"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "retrieved_passages",
              "complete_scope"
            ],
            "title": "Strategy"
          },
          "is_simulated": {
            "type": "boolean",
            "title": "Is Simulated"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_ids",
          "selected_source_count",
          "supplied_source_count",
          "strategy",
          "is_simulated"
        ],
        "title": "ContextManifest"
      },
      "Corpus": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "subtitle": {
            "type": "string",
            "title": "Subtitle"
          },
          "edition": {
            "type": "string",
            "title": "Edition"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "original_companion_notes",
              "original_fiction",
              "ingested_edition"
            ],
            "title": "Source Kind"
          },
          "book_count": {
            "type": "integer",
            "title": "Book Count"
          },
          "source_count": {
            "type": "integer",
            "title": "Source Count"
          },
          "examples": {
            "items": {
              "$ref": "#/components/schemas/ExampleQuestion"
            },
            "type": "array",
            "title": "Examples"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "subtitle",
          "edition",
          "source_kind",
          "book_count",
          "source_count",
          "examples"
        ],
        "title": "Corpus"
      },
      "EvidenceResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "branch_id": {
            "type": "string",
            "title": "Branch Id"
          },
          "claim": {
            "$ref": "#/components/schemas/Claim"
          },
          "citation": {
            "$ref": "#/components/schemas/Citation"
          },
          "source": {
            "$ref": "#/components/schemas/SourcePassage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "branch_id",
          "claim",
          "citation",
          "source"
        ],
        "title": "EvidenceResponse"
      },
      "ExampleQuestion": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "question"
        ],
        "title": "ExampleQuestion"
      },
      "ExperimentRun": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "mock",
              "live"
            ],
            "title": "Data Mode"
          },
          "is_preview": {
            "type": "boolean",
            "title": "Is Preview"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "complete",
              "cancelled",
              "failed"
            ],
            "title": "Status"
          },
          "configuration": {
            "$ref": "#/components/schemas/RunConfiguration"
          },
          "branches": {
            "items": {
              "$ref": "#/components/schemas/Branch"
            },
            "type": "array",
            "title": "Branches"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourcePassage"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "question",
          "mode",
          "data_mode",
          "is_preview",
          "created_at",
          "status",
          "configuration",
          "branches",
          "sources"
        ],
        "title": "ExperimentRun"
      },
      "Method": {
        "type": "string",
        "enum": [
          "rag",
          "full_context"
        ],
        "title": "Method"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "rag",
          "full_context",
          "compare"
        ],
        "title": "Mode"
      },
      "RunConfiguration": {
        "properties": {
          "corpus_id": {
            "type": "string",
            "title": "Corpus Id"
          },
          "corpus_version": {
            "type": "string",
            "title": "Corpus Version"
          },
          "scope_label": {
            "type": "string",
            "title": "Scope Label"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "output_limit": {
            "type": "integer",
            "title": "Output Limit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "corpus_id",
          "corpus_version",
          "scope_label",
          "model",
          "prompt_version",
          "output_limit"
        ],
        "title": "RunConfiguration"
      },
      "RunMetrics": {
        "properties": {
          "basis": {
            "type": "string",
            "enum": [
              "illustrative",
              "provider_reported",
              "unavailable"
            ],
            "title": "Basis"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "cached_input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cached Input Tokens"
          },
          "estimated_cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Cost Usd"
          },
          "pricing_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricing Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "basis"
        ],
        "title": "RunMetrics"
      },
      "RunRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Question"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "default": "compare"
          },
          "corpus_id": {
            "type": "string",
            "title": "Corpus Id"
          },
          "corpus_version": {
            "type": "string",
            "title": "Corpus Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "corpus_id",
          "corpus_version"
        ],
        "title": "RunRequest"
      },
      "SourcePassage": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "corpus_id": {
            "type": "string",
            "title": "Corpus Id"
          },
          "corpus_version": {
            "type": "string",
            "title": "Corpus Version"
          },
          "book": {
            "type": "string",
            "title": "Book"
          },
          "book_short": {
            "type": "string",
            "title": "Book Short"
          },
          "edition": {
            "type": "string",
            "title": "Edition"
          },
          "chapter": {
            "type": "string",
            "title": "Chapter"
          },
          "chapter_number": {
            "type": "integer",
            "title": "Chapter Number"
          },
          "page_label": {
            "type": "string",
            "title": "Page Label"
          },
          "page_kind": {
            "type": "string",
            "enum": [
              "demo_folio",
              "printed",
              "pdf",
              "location"
            ],
            "title": "Page Kind"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "attribution": {
            "type": "string",
            "title": "Attribution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "corpus_id",
          "corpus_version",
          "book",
          "book_short",
          "edition",
          "chapter",
          "chapter_number",
          "page_label",
          "page_kind",
          "text",
          "attribution"
        ],
        "title": "SourcePassage"
      }
    }
  }
}
